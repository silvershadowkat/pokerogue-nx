+
+const MEGA_FORM_KEYS = new Set<string>([
+  SpeciesFormKey.MEGA,
+  SpeciesFormKey.MEGA_X,
+  SpeciesFormKey.MEGA_Y,
+  SpeciesFormKey.MEGA_Z,
+  SpeciesFormKey.MEGA_ORIGINAL,
