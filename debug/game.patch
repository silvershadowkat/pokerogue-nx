@@ -0,0 +1,72 @@
+import { showDebugText } from "#app/debug/ui-message";
+import { globalScene } from "#app/global-scene";
+import { UiMode } from "#enums/ui-mode";
+import { getPlayerCandyJarCount, setPlayerCandyJarCount } from "#modifiers/modifier";
+import type { OptionSelectItem } from "#types/ui-types";
+import { Setting, getSandboxSetting, saveSandboxSetting } from "./sandbox-settings";
+
+/** Every menu here belongs to the separately compiled local Debug game. */
+function options(items: OptionSelectItem[], initialCursor = 0, pageStep = 5): void {
+  globalScene.ui.hideTooltip();
+  void globalScene.ui.refreshOverlayMode(UiMode.OPTION_SELECT, {
+    options: items, maxOptions: 7, initialCursor, pageStep,
+    measureVisibleOptionsOnly: true,
+  });
+}
+
+function valueLabel(row: Setting): string {
+  const value = getSandboxSetting(row.key);
+  if (row.directValue) return String(globalScene.currentBattle ? getPlayerCandyJarCount() : value);
+  return row.options[value]?.label ?? String(value);
+}
+
+function chooseSetting(row: Setting, back: () => void): void {
+  const current = row.directValue && globalScene.currentBattle ? getPlayerCandyJarCount() : getSandboxSetting(row.key);
+  const apply = (value: number): boolean => {
+    if (!saveSandboxSetting(row.key, value)) return false;
+    if (row.directValue && globalScene.currentBattle) setPlayerCandyJarCount(value);
+    back();
+    return true;
+  };
+  const items: OptionSelectItem[] = row.directValue
+    ? Array.from({length: 10000}, (_, value) => ({label: value.toLocaleString(), handler: () => apply(value)}))
+    : row.options.map((option, value) => ({label: option.label, handler: () => apply(value)}));
+  items.push({label: "Cancel", handler: () => (back(), true)});
+  showDebugText(row.label, 0);
+  options(items, row.directValue ? Math.min(current,9999) : current, row.directValue ? 10 : 5);
+}
+
+export function showSandboxMenu(): void {
+  const groups = new Map<string, Setting[]>();
+  let current = "Presentation";
+  for (const row of Setting) {
+    if (row.categoryHeader) { current = row.label.replace(/^[\s=-]+|[\s=-]+$/g, ""); continue; }
+    if (!groups.has(current)) groups.set(current, []);
+    groups.get(current)!.push(row);
+  }
+  const root = (): void => {
+    showDebugText("Debug Tools\nLocal saves only.", 0);
+    const items: OptionSelectItem[] = [...groups.keys()].map(name => ({label:name, handler: () => (category(name), true)}));
+    items.push({label:"Clear local Debug data",handler:()=>{
+      showDebugText("Erase this device's Debug saves, builds and settings? Online and Offline profiles are kept.",0);
+      void globalScene.ui.setOverlayMode(UiMode.CONFIRM,{
+        yesHandler:()=>{localStorage.clear();window.location.reload();},
+        noHandler:()=>{void globalScene.ui.revertMode().then(root);},
+        inputDelay:1500,
+      });return true;
+    }});
+    items.push({label:"Back", handler: () => (globalScene.ui.revertMode(), true)});
+    options(items);
+  };
+  const category = (name: string, cursor = 0): void => {
+    const rows = groups.get(name)!;
+    const items: OptionSelectItem[] = rows.map((row, index) => ({
+      label: `${row.label}: ${valueLabel(row)}`,
+      handler: () => (chooseSetting(row, () => category(name, index)), true),
+    }));
+    items.push({label:"Back", handler: () => (root(), true)});
+    showDebugText("", 0);
+    options(items, cursor);
+  };
+  root();
+}
